{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ContinuousPlanning": {
      "properties": {
        "acceptance": {
          "type": "string"
        },
        "estimatedCompletionAt": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "description": "Host-assigned identity, retained across revisions and changed for a new task.",
          "type": "string"
        },
        "nextReviewAt": {
          "format": "int64",
          "type": "integer"
        },
        "objective": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "review": {
          "$ref": "#/definitions/PlanReviewState"
        },
        "stages": {
          "items": {
            "$ref": "#/definitions/PlanStage"
          },
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/definitions/TimedPlanStep"
          },
          "type": "array"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "acceptance",
        "estimatedCompletionAt",
        "id",
        "nextReviewAt",
        "objective",
        "reason",
        "review",
        "stages",
        "steps",
        "updatedAt",
        "version"
      ],
      "type": "object"
    },
    "PlanReviewState": {
      "enum": [
        "idle",
        "due",
        "running",
        "unavailable"
      ],
      "type": "string"
    },
    "PlanStage": {
      "properties": {
        "acceptance": {
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "estimateSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "acceptance",
        "assumptions",
        "estimateSeconds",
        "id",
        "title"
      ],
      "type": "object"
    },
    "PlanStepDefinition": {
      "properties": {
        "acceptance": {
          "type": "string"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "estimateSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "stageId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "acceptance",
        "dependencies",
        "estimateSeconds",
        "id",
        "stageId",
        "title"
      ],
      "type": "object"
    },
    "PlanStepState": {
      "enum": [
        "pending",
        "running",
        "reviewing",
        "completed",
        "blocked",
        "cancelled"
      ],
      "type": "string"
    },
    "TimedPlanStep": {
      "properties": {
        "completedAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "definition": {
          "$ref": "#/definitions/PlanStepDefinition"
        },
        "elapsedSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "initialEstimateSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "owner": {
          "type": "string"
        },
        "runningSince": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "startedAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "$ref": "#/definitions/PlanStepState"
        },
        "submittedAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "definition",
        "elapsedSeconds",
        "evidence",
        "initialEstimateSeconds",
        "owner",
        "state"
      ],
      "type": "object"
    }
  },
  "properties": {
    "observedAt": {
      "description": "Server clock when this view was sent, including snapshots on resume.",
      "format": "int64",
      "type": "integer"
    },
    "plan": {
      "$ref": "#/definitions/ContinuousPlanning"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "observedAt",
    "plan",
    "threadId"
  ],
  "title": "ThreadPlanUpdatedNotification",
  "type": "object"
}